{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Secret": "SuperSecretKeyForAuthenticationAndJwtValidation2026!eProjectSecureKey#",
    "Issuer": "IdentityService",
    "Audience": "eProjectClient"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-roles-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "donation-route": {
        "ClusterId": "donation-cluster",
        "Match": {
          "Path": "/api/donations/{**catch-all}"
        }
      },
      "donation-root-route": {
        "ClusterId": "donation-cluster",
        "Match": {
          "Path": "/api/donations"
        }
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/api/content/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5131"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": {
            "Address": "http://localhost:5121"
          }
        }
      },
      "donation-cluster": {
        "Destinations": {
          "donation-api": {
            "Address": "http://localhost:5141"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "content-api": {
            "Address": "http://localhost:5151"
          }
        }
      }
    }
  }
}
